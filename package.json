{
  "name": "@fjell/express-router",
  "description": "Express Router for Fjell",
  "version": "4.4.84",
  "keywords": [
    "express",
    "router",
    "fjell"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=21"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && node build.js",
    "dev": "nodemon --watch src --ext ts --exec 'npm run build'",
    "lint": "eslint . --ext .ts --fix",
    "clean": "rm -rf dist",
    "test": "npm run lint && vitest run --coverage",
    "precommit": "npm run clean && npm run lint && npm run build && npm run test",
    "prepublishOnly": "npm run clean && npm run build",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "docs:test": "cd docs && npm run test"
  },
  "dependencies": {
    "@fjell/core": "^4.4.80",
    "@fjell/lib": "^4.4.90",
    "@fjell/logging": "^4.4.73",
    "@fjell/registry": "^4.4.87",
    "@fjell/validation": "^4.4.7",
    "deepmerge": "^4.3.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.4",
    "@fjell/common-config": "^1.1.41",
    "@tsconfig/recommended": "^1.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjellgrunn/express-router.git"
  },
  "bugs": {
    "url": "https://github.com/fjellgrunn/express-router/issues"
  },
  "homepage": "https://github.com/fjellgrunn/express-router#readme",
  "author": "Fjell Team",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "guide"
  ]
}
